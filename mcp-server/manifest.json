
{
  "manifest_version": "0.3",
  "name": "student-management",
  "display_name": "Student Management",
  "version": "1.0.0",
  "description": "Manage student records using the deployed Student Management API.",
  "author": {
    "name": "Student Management Project"
  },
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "API_BASE_URL": "https://three-tier-student-system.onrender.com"
      }
    }
  }
}
